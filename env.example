# ── App PostgreSQL (raw / features / serving / pipeline schemas) ──────────
# These also compose RECSYS_DB_URL for the app container in docker-compose.yml
RECSYS_PG_USER=postgres
RECSYS_PG_PASSWORD=postgres
RECSYS_PG_DB=movielens

# Used directly by config/settings.py when running main.py outside Docker
# (defaults to postgresql+psycopg2://postgres:postgres@localhost:5432/movielens)
RECSYS_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/movielens

# development | test | production — appends "_test" to the DB name when "test"
RECSYS_ENV=development

# ── MLflow's dedicated PostgreSQL (also backs Optuna's optuna_studies DB) ──
MLFLOW_PG_USER=mlflow
MLFLOW_PG_PASSWORD=mlflow
MLFLOW_PG_DB=mlflow

# MLflow tracking server URI (used by tune/train/evaluate stages)
MLFLOW_TRACKING_URI=http://localhost:5000

# Optuna RDB storage — enables resumable hyperparameter sweeps
OPTUNA_STORAGE_URL=postgresql+psycopg2://mlflow:mlflow@localhost:5433/optuna_studies

# ── MinIO (model checkpoints, FAISS indices, teacher snapshots) ───────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000

# ── ETL ────────────────────────────────────────────────────────────────────
# Path to a MovieLens .zip, extracted directory, or single data file
MOVIELENS_DATA_DIR=/data
INGEST_MODE=upsert

# ── Serving ─────────────────────────────────────────────────────────────────
PORT=8000
